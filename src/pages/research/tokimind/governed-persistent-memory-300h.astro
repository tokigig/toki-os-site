    <div class="shell">
      <p class="eyebrow">tokiMind research · v1.0</p>

      <h1 class="paper-title">
        Governed Persistent Memory Under Enterprise Churn
      </h1>

      <p class="paper-subtitle">
        A 300-Hour Paired Evaluation of Accuracy, Security, Efficiency, and Reliability
      </p>

      <dl class="metadata">
        <dt>Author</dt>
        <dd>Michael S. Miller</dd>

        <dt>Affiliation</dt>
        <dd>tokiGig LLC</dd>

        <dt>ORCID</dt>
        <dd>
          <a href={`https://orcid.org/${orcid}`}>{orcid}</a>
        </dd>

        <dt>Manuscript DOI</dt>
        <dd>
          <a href={`https://doi.org/${manuscriptDoi}`}>{manuscriptDoi}</a>
        </dd>

        <dt>Evidence DOI</dt>
        <dd>
          <a href={`https://doi.org/${datasetDoi}`}>{datasetDoi}</a>
        </dd>

        <dt>Experiment</dt>
        <dd>tokimind-longitudinal-v4-enterprise-300h-r1</dd>

        <dt>Frozen code revision</dt>
        <dd>6975e8344666e98ff71e355ebd4ff9e7b0fe08da</dd>
      </dl>

      <div class="actions">
