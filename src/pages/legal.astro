---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Legal — tokiOS"
  description="Legal notices for tokiOS research, technical materials, and site content."
  canonicalPath="/legal/"
>
  <header class="page-header">
    <div class="shell">
      <p class="eyebrow">Legal</p>
      <h1>Legal notices.</h1>
      <p class="hero-copy">
        These notices apply to the tokiOS website, published technical materials,
        and research summaries unless a specific work states otherwise.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="shell prose">
      <h2>Copyright</h2>
      <p>
        © 2026 tokiGig LLC. All rights reserved. Unless otherwise stated,
        original site text, diagrams, technical descriptions, and presentation
        materials on this website are owned by tokiGig LLC or used with permission.
        Separately published research, datasets, software, and third-party works
        remain subject to the licenses and terms stated with those materials.
      </p>

      <h2>Patent notice</h2>
      <p>
        Certain technologies described on this website, including technologies
        underlying tokiMind, are the subject of a pending U.S. patent application.
        This notice does not imply that every feature, component, or concept
        described on this site is covered by a patent claim.
