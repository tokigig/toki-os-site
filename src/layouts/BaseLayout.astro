---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  article?: boolean;
}

const {
  title,
  description,
  canonicalPath = "/",
  article = false,
} = Astro.props;

const siteUrl = "https://toki-os.com";
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary" />

    <slot name="head" />
  </head>

  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="tokiOS home">
          <span class="brand-mark">tokiOS</span>
          <span class="brand-sub">Agent Systems Infrastructure</span>
        </a>

        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/research/">Research</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-main">
        <div class="footer-brand">
          <strong>tokiOS</strong>
          <p>
            Infrastructure for multi-agent systems: identity, governed context,
            persistent memory, authority, and durable execution.
          </p>
        </div>

        <div class="footer-utility">
          <div class="footer-group">
            <span class="footer-label">Contact</span>
            <a href="mailto:info@toki-os.com">info@toki-os.com</a>
            <a href="https://x.com/TokiOSHQ" rel="me noopener noreferrer">X · @TokiOSHQ</a>
          </div>

          <div class="footer-group">
            <span class="footer-label">Links</span>
            <a href="/research/">Research</a>
            <a href="/legal/">Legal</a>
          </div>

          <p class="footer-patent">
            Certain technologies described on this site are subject to a pending
            U.S. patent application.
          </p>
        </div>
      </div>

      <div class="footer-bottom">
        <div class="shell">
          <span>© 2026 tokiGig LLC. All rights reserved.</span>
        </div>
      </div>
    </footer>
  </body>
</html>
